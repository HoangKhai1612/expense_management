<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app talks to the backend over plain HTTP. Cleartext is enabled
         application-wide via android:usesCleartextTraffic, because there is no
         network security config: the default API base URL is http://10.0.2.2:8081
         and restricting cleartext per host would break LAN testing on a physical
         device. This is a debug-build concession; TLS is an open production gap. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 16+ blocks app traffic to private-range addresses unless this is
         declared. The emulator reaches the developer machine at 10.0.2.2, which the
         platform classifies as local network. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".FinaiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Expense_management"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Expense_management"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>