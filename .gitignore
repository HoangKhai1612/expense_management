# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
credentials/

# ---- Java / Maven / Gradle ----
backend/target/
*.jar
# Wrapper jars are required for a fresh clone to build at all:
# without gradle-wrapper.jar, ./gradlew cannot find GradleWrapperMain.
!.mvn/wrapper/maven-wrapper.jar
!android/gradle/wrapper/gradle-wrapper.jar

# ---- Node / Admin Web ----
node_modules/
admin-web/dist/
admin-web/.vite/
npm-debug.log*
yarn-error.log*

# ---- Android ----
android/.gradle/
# Root-level Gradle cache created when Gradle is invoked from the repository
# root instead of android/. The wrapper must be run from android/; running it
# from the root creates this cache and breaks the documented build command.
.gradle/
android/build/
android/app/build/
android/local.properties
android/.kotlin/
android/captures/
*.apk
*.aab
*.keystore
!debug.keystore

# ---- IDE / agent tooling ----
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.kilo/
.claude/
.cursor/

# Stray nested clone of the GitHub template remote, created accidentally during
# repository reconciliation. It contains only the template README and no unique
# work. Must never be committed: git would otherwise record it as a submodule.
expense_management/

# ---- OS ----
Thumbs.db
.DS_Store
desktop.ini

# ---- Test evidence / logs ----
logs/
*.log

# ---- Local artefacts not part of the deliverable ----
# Screenshots captured ad hoc during local debugging. Not referenced by any
# document, and not verified, so they must not be committed.
screenshot.png
android/screenshots/

# Python bytecode from the report toolchain
__pycache__/
*.pyc

# Audit output of the pre-submission check. The checks themselves live in
# report/audit/ and are tracked; their generated reports are not a deliverable.
report-validation/

# Word lock files, left behind if Word is killed while a document is open
~$*.docx
