# Personal Finance AI System - environment template
#
# Copy to .env and fill in real values:
#   cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------- database
DB_NAME=finai
DB_USER=finai
# Host port for PostgreSQL. Offset from 5432 so it can run beside an existing
# local PostgreSQL instance.
DB_HOST_PORT=5433
DB_PASSWORD=change-me-database-password

# ---------------------------------------------------------------- backend
BACKEND_HOST_PORT=8081
# Must be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=12h

# Browser origins allowed to call the API from the Admin Web app.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Bootstrap administrator. Created on first start only; the password is never
# stored in a migration file or committed anywhere.
APP_ADMIN_EMAIL=admin@finai.local
APP_ADMIN_PASSWORD=change-me-admin-password

# ------------------------------------------------------------------- admin
ADMIN_HOST_PORT=5173
# Base URL the Admin Web bundle calls. From a browser this is the host port.
ADMIN_API_BASE_URL=http://localhost:8081

# ---------------------------------------------------------------------- ai
# LOCAL = built-in deterministic analyst, works offline, no API key needed.
# OPENAI_COMPATIBLE = adds a natural-language commentary layer on top of the
# verified facts. The FACT block is always produced locally and never by the model.
AI_PROVIDER=LOCAL
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini

# -------------------------------------------------------- budget alerting
# Single source of truth for the thresholds; not hard-coded in any module.
BUDGET_WARNING_THRESHOLD=80
BUDGET_EXCEEDED_THRESHOLD=100

# --------------------------------------------------------------- logging
LOG_LEVEL=INFO
